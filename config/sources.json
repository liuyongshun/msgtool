  "global_settings": {
    "default_cache_ttl": 300,
    "default_fetch_limit": 10,
    "max_fetch_limit": 50,
    "request_timeout": 30,
    "user_agent": "Mozilla/5.0 (compatible; MsgSkill/1.0; +https://github.com/msgskill)",
    "scheduler": {
      "enabled": true,
      "tasks": {
        "arxiv": {
          "enabled": true,
          "time": "21:52",
          "max_results": 8,
          "note": "少量关注：仅 cs.AI / cs.LG / cs.CL，每个分类最多 8 篇",
          "translation_strategy": {
            "enabled": true,
            "selective_translation": true,
            "min_authors": 2,
            "note": "选择性翻译：只翻译作者数>=2的高质量论文"
          }
        },
        "hackernews": {
          "enabled": true,
          "time": [
            "10:20",
            "18:20"
          ],
          "max_results": 50,
          "note": "每天两次。控制原始抓取数量，AI筛选后的结果都会保存"
        },
        "rss": {
          "enabled": true,
          "time": [
            "08:45",
            "20:10"
          ],
          "max_results": 20,
          "note": "每天两次。每个RSS源最多抓取的条目数，AI筛选后的结果都会保存"
        },
        "github": {
          "enabled": true,
          "time": "21:52",
          "max_results": 70,
          "note": "控制每种查询类型的抓取上限，AI筛选后的所有结果都会保存"
        }
      }
    }
